{
  "manifest_version": 3,
  "name": "Phishing Detection Extension",
  "version": "1.0",
  "description": "Detects phishing websites and alerts users",
  "permissions": [
    "tabs",
    "activeTab",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://your-orchestrator.onrender.com/*",
    "https://your-brain-api.onrender.com/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Detector"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}