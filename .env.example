# Environment Variables for Phishing Detection System
# Copy this file to .env and update with your actual values

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=password123

# For production deployment, use strong passwords:
# MONGO_USERNAME=your_secure_username
# MONGO_PASSWORD=your_secure_password

# Orchestrator Service Configuration
# BRAIN_API_URL=http://brain-api:8000/predict
# MONGODB_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongodb:27017/phishing_detection?authSource=admin

# Browser Extension Configuration
# Update BACKEND_URL in browser-extension/background.js and popup.js
# For local development: http://localhost:8080
# For production: https://your-deployment-url.com
